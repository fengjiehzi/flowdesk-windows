<Window x:Class="SmartDeskBox.DesktopApp.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="流屿桌面 · 桌面管理" Width="1180" Height="800" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.InputBindings><KeyBinding Command="ApplicationCommands.Find" Key="F" Modifiers="Control"/></Window.InputBindings>
 <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch_Executed" CanExecute="FocusSearch_CanExecute"/></Window.CommandBindings>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
   <Grid Margin="14,24,14,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="10,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Selection}" HorizontalAlignment="Left" VerticalAlignment="Top"><UniformGrid Rows="2" Columns="2" Margin="8"><Border Background="{DynamicResource Accent}" CornerRadius="1" Margin="0,0,2,2"/><Border Background="{DynamicResource Accent}" CornerRadius="1" Opacity="0.45" Margin="2,0,0,2"/><Border Background="{DynamicResource Accent}" CornerRadius="1" Opacity="0.45" Margin="0,2,2,0"/><Border Background="{DynamicResource Accent}" CornerRadius="1" Margin="2,2,0,0"/></UniformGrid></Border><StackPanel Grid.Column="1"><TextBlock Text="流屿桌面" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="桌面，由你安排" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" FontSize="11"/></StackPanel></Grid>
    <StackPanel Grid.Row="1">
     <TextBlock Text="桌面分类" Foreground="{DynamicResource Muted}" FontSize="11" Margin="15,0,0,8"/>
     <RadioButton x:Name="AllNavigation" Tag="All" GroupName="Sections" IsChecked="True" Style="{StaticResource Navigation}" Checked="Section_Checked" AutomationProperties.Name="全部分类"><Grid Width="128"><TextBlock Text="全部分类" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock x:Name="AllCount" Text="0" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton Tag="Apps" GroupName="Sections" Style="{StaticResource Navigation}" Checked="Section_Checked" AutomationProperties.Name="应用"><Grid Width="128"><TextBlock Text="应用" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock x:Name="AppsCount" Text="0" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton Tag="Files" GroupName="Sections" Style="{StaticResource Navigation}" Checked="Section_Checked" AutomationProperties.Name="文件"><Grid Width="128"><TextBlock Text="文件" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock x:Name="FilesCount" Text="0" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton Tag="Pending" GroupName="Sections" Style="{StaticResource Navigation}" Checked="Section_Checked" AutomationProperties.Name="待确认应用"><Grid Width="128"><TextBlock Text="待确认" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock x:Name="PendingCount" Text="0" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid></RadioButton>
     <Separator Margin="10,18"/>
     <RadioButton Content="备份与数据" Tag="Data" GroupName="Sections" Style="{StaticResource Navigation}" Checked="Section_Checked"/>
    </StackPanel>
    <StackPanel Grid.Row="3"><Button Content="显示桌面区块" Click="ShowDesktop_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/><Button Content="恢复系统桌面" Click="RestoreDesktop_Click" HorizontalContentAlignment="Left"/><TextBlock Text="分类不搬动原文件" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,16,0,4"/><TextBlock Text="文件操作由 Windows 执行" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,0,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="SectionTitle" Text="全部分类" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock x:Name="TotalText" Text="0" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Text=" 个桌面项目" Foreground="{DynamicResource Muted}"/><Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}" Margin="12,0" VerticalAlignment="Center"/><TextBlock x:Name="EngineText" Text="离线分类" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
    <Button x:Name="SettingsButton" Grid.Column="1" Content="设置" Click="Settings_Click" VerticalAlignment="Top" ToolTip="外观、桌面交互、分类与 AI、数据"/>
   </Grid>
   <Grid Grid.Row="1" x:Name="ActionsPanel" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Grid Margin="0,0,0,6"><TextBlock Text="搜索当前分类" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="Ctrl+F 定位 · Esc 清空" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/></Grid><Grid><TextBox x:Name="SearchBox" Padding="10,9,44,9" TextChanged="Search_Changed" ToolTip="搜索名称、文件名、用途、分类或路径" AutomationProperties.Name="搜索桌面项目"/><Button x:Name="ClearSearchButton" Content="×" Click="ClearSearch_Click" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" MinHeight="28" Padding="0" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" FontSize="18" ToolTip="清空搜索（Esc）" AutomationProperties.Name="清空搜索"/></Grid></StackPanel>
    <Button Grid.Column="1" Content="重新扫描" Click="Scan_Click" Style="{StaticResource PrimaryButton}" Margin="12,19,0,0" VerticalAlignment="Top"/>
    <TextBlock x:Name="SearchResultsText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
   <Grid Grid.Row="2">
    <ScrollViewer x:Name="CanvasScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Canvas_SizeChanged">
     <ItemsControl x:Name="BoxesControl" ItemsSource="{Binding FilteredBoxes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Width="{Binding BoxWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding PreviewHeight}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,12" AllowDrop="True" Drop="Box_Drop" DragOver="Box_DragOver">
        <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Border Background="{DynamicResource Page}" CornerRadius="9,9,0,0" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="14,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="8" Height="8" Background="{Binding Info.Color}" CornerRadius="2"/>
          <TextBlock Grid.Column="1" Text="{Binding Info.Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="6" MinWidth="24" Height="24" VerticalAlignment="Center" Margin="8,0,4,0" Padding="5,0" ToolTip="当前匹配的项目数"><TextBlock Text="{Binding VisibleCount}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Button Grid.Column="3" Content="{Binding ToggleGlyph}" Click="Collapse_Click" Padding="8,0" MinHeight="28" Background="Transparent" BorderBrush="Transparent" ToolTip="折叠 / 展开分类"/>
         </Grid></Border>
         <Grid Grid.Row="1" Margin="7,8" Visibility="{Binding ContentVisibility}">
          <TextBlock Text="此分类暂时没有项目" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <ListBox ItemsSource="{Binding VisibleItems}" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Item_DoubleClick" PreviewMouseLeftButtonDown="Item_MouseDown" PreviewMouseMove="Item_MouseMove">
           <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
           <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Detail}" ToolTipService.InitialShowDelay="500" ContextMenuOpening="Item_ContextMenuOpening"><Grid.ContextMenu><ContextMenu/></Grid.ContextMenu><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="□" Visibility="{Binding FallbackVisibility}" Foreground="{DynamicResource Muted}" FontSize="22"/><Image Source="{Binding Icon}" Width="28" Height="28"/></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
           </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
         </Grid>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="400" Margin="24"><TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="EmptyDescription" Foreground="{DynamicResource Muted}" Margin="0,10,0,20" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"/><Button x:Name="EmptyActionButton" Click="EmptyAction_Click" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"/></StackPanel>
    <ScrollViewer x:Name="DataPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="桌面文件备份" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="把当前项目复制到独立沙盒，保留原桌面文件。撤销只清理上次备份生成的沙盒副本。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="22"/><WrapPanel><Button Content="创建沙盒备份" Click="Organize_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="撤销上次备份" Click="Rollback_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="24"><StackPanel><TextBlock Text="本地数据" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="分类偏好、布局和界面设置保存在本机。导出的报表包含项目路径，请按需分享。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="22"/><WrapPanel><Button Content="导出分类 JSON" Click="ExportReport_Click" Margin="0,0,10,8"/><Button Content="打开数据目录" Click="OpenData_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,6,0,0"><StackPanel><ProgressBar x:Name="BusyProgress" Height="2" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="就绪 · 分类不搬动文件，手动文件操作作用于原文件" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
