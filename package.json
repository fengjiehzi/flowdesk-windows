{
  "name": "flowdesk",
  "version": "1.0.36",
  "productName": "流屿桌面",
  "description": "集快捷启动、通知提醒、剪贴板归档与桌面分类整理于一体的 Windows 桌面效率工具",
  "author": "FlowDesk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengjiehzi/vibe-flow.git"
  },
  "bugs": {
    "url": "https://github.com/fengjiehzi/vibe-flow/issues"
  },
  "homepage": "https://github.com/fengjiehzi/vibe-flow#readme",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "tsx src/shared/settings.test.ts && tsx src/shared/islandState.test.ts && tsx src/shared/islandPresentation.test.ts && tsx src/shared/triggerGesture.test.ts && tsx src/shared/launcher.test.ts && tsx src/shared/notifications.test.ts",
    "native:self-test": "dotnet run --project native/NotificationBridge/NotificationBridge.csproj -c Release -- --self-test",
    "desktop:build": "pwsh -NoProfile -File scripts/build-desktop-boxes.ps1",
    "desktop:test": "tsx src/main/desktopBoxes.test.ts",
    "identity:dev": "pwsh -NoProfile -File scripts/build-windows.ps1 -Mode Dev -Register",
    "pack:win": "pwsh -NoProfile -File scripts/build-windows.ps1 -Mode Release && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-store": "^10.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.desktop.dynamicisland",
    "productName": "流屿桌面",
    "asar": true,
    "forceCodeSigning": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/generated/desktop-boxes",
        "to": "desktop-boxes"
      },
      {
        "from": "build/generated/native",
        "to": "native"
      },
      {
        "from": "build/generated/identity/WindowsDynamicIsland.Identity.msix",
        "to": "identity/WindowsDynamicIsland.Identity.msix"
      }
    ],
    "win": {
      "icon": "resources/app-icon.ico",
      "target": "nsis",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "artifactName": "FlowDesk-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
